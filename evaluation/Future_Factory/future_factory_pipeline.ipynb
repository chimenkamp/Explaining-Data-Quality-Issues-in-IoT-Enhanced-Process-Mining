   "metadata": {},
   "source": [
    "## 2. Data Quality Detection\n",
    "\n",
    "We analyze the raw sensor data for quality issues including:\n",
    "- **Missing values**: Gaps in time series\n",
    "- **Sensor noise**: Statistical outliers and fluctuations\n",
    "- **Drift**: Baseline shifts over time\n",
    "- **Boolean flicker**: Rapid state changes\n",
    "\n",
    "**Important**: Quality issues are tracked at the **timestamp level**, not globally per sensor. This means we mark only the specific problematic readings (e.g., statistical outliers), not every reading from a sensor that has some noise."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "d6aa4e68",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "🔍 Running data quality detection...\n",
      "\n",
      "Missing value issues: 0\n",
      "Sensor noise issues: 27\n",
      "Boolean flicker issues: 0\n",
      "\n",
      "📋 Total quality issues detected: 27\n",
      "📍 Timestamp-level quality flags: 524,295\n",
      "   (Note: One timestamp can have multiple sensor issues)\n",
      "Sensor noise issues: 27\n",
      "Boolean flicker issues: 0\n",
      "\n",
      "📋 Total quality issues detected: 27\n",
      "📍 Timestamp-level quality flags: 524,295\n",
      "   (Note: One timestamp can have multiple sensor issues)\n"
     ]
    }
   ],
   "source": [
    "# Initialize quality issue tracking\n",
    "quality_issues = []\n",
    "quality_flags_df = df.copy()  # Create a copy to store per-timestamp quality flags\n",
    "\n",
    "# Add quality flag columns for each sensor\n",
    "for col in df.columns:\n",
    "    if col.startswith(('M_', 'I_', 'Q_')) and col != 'Q_Cell_CycleCount':\n",
    "        quality_flags_df[f'{col}_quality_flag'] = False\n",
    "\n",
    "def detect_missing_values(df, quality_flags_df):\n",
    "    \"\"\"Detect missing or NaN values in the dataset\"\"\"\n",
    "    issues = []\n",
    "    missing = df.isnull().sum()\n",
    "    for col in missing[missing > 0].index:\n",
    "        if col.startswith(('M_', 'I_', 'Q_')) and col != 'Q_Cell_CycleCount':\n",
    "            # Mark missing values\n",
    "            quality_flags_df.loc[df[col].isnull(), f'{col}_quality_flag'] = True\n",
    "            issues.append({\n",
    "                'type': 'missing_value',\n",
    "                'sensor': col,\n",
    "                'count': int(missing[col]),\n",
    "                'percentage': missing[col] / len(df) * 100\n",
    "            })\n",
    "    return issues\n",
    "\n",
    "def detect_sensor_noise(df, quality_flags_df, sensor_cols, z_threshold=3.5):\n",
    "    \"\"\"Detect statistical outliers in sensor readings using z-score and mark specific timestamps\"\"\"\n",
    "    issues = []\n",
    "    for col in sensor_cols:\n",
    "        if df[col].dtype in ['float64', 'int64']:\n",
    "            # Calculate z-scores\n",
    "            values = df[col].dropna()\n",
    "            if len(values) > 0:\n",
    "                z_scores = np.abs(stats.zscore(values))\n",
    "                outlier_mask = z_scores > z_threshold\n",
    "                \n",
    "                # Mark outlier timestamps in quality flags\n",
    "                outlier_indices = values[outlier_mask].index\n",
    "                quality_flags_df.loc[outlier_indices, f'{col}_quality_flag'] = True\n",
    "                \n",
    "                outliers = np.sum(outlier_mask)\n",
    "                if outliers > 0:\n",
    "                    issues.append({\n",
    "                        'type': 'sensor_noise',\n",
    "                        'sensor': col,\n",
    "                        'outlier_count': int(outliers),\n",
    "                        'percentage': outliers / len(df) * 100,\n",
    "                        'outlier_indices': outlier_indices.tolist()  # Store indices for later reference\n",
    "                    })\n",
    "    return issues\n",
    "\n",
    "def detect_boolean_flicker(df, quality_flags_df, bool_cols, window=5):\n",
    "    \"\"\"Detect rapid state changes in boolean sensors\"\"\"\n",
    "    issues = []\n",
    "    for col in bool_cols:\n",
    "        # Count state changes\n",
    "        changes = (df[col] != df[col].shift())\n",
    "        change_indices = df[changes].index\n",
    "        \n",
    "        if changes.sum() > len(df) * 0.1:  # More than 10% state changes\n",
    "            # Mark rapid changes as quality issues\n",
    "            quality_flags_df.loc[change_indices, f'{col}_quality_flag'] = True\n",
    "            \n",
    "            issues.append({\n",
    "                'type': 'boolean_flicker',\n",
    "                'sensor': col,\n",
    "                'change_count': int(changes.sum()),\n",
    "                'change_rate': changes.sum() / len(df) * 100\n",
    "            })\n",
    "    return issues\n",
    "\n",
    "# Run quality detection\n",
    "print(\" Running data quality detection...\\n\")\n",
    "\n",
    "# Detect missing values\n",
    "missing_issues = detect_missing_values(df, quality_flags_df)\n",
    "quality_issues.extend(missing_issues)\n",
    "print(f\"Missing value issues: {len(missing_issues)}\")\n",
    "\n",
    "# Detect sensor noise\n",
    "sensor_cols = [col for col in df.columns if col.startswith(('M_', 'I_', 'Q_')) and col != 'Q_Cell_CycleCount']\n",
    "noise_issues = detect_sensor_noise(df, quality_flags_df, sensor_cols)\n",
    "quality_issues.extend(noise_issues)\n",
    "print(f\"Sensor noise issues: {len(noise_issues)}\")\n",
    "\n",
    "# Detect boolean flicker\n",
    "bool_cols = [col for col in df.columns if df[col].dtype == 'bool']\n",
    "flicker_issues = detect_boolean_flicker(df, quality_flags_df, bool_cols)\n",
    "quality_issues.extend(flicker_issues)\n",
    "print(f\"Boolean flicker issues: {len(flicker_issues)}\")\n",
    "\n",
    "print(f\"\\n Total quality issues detected: {len(quality_issues)}\")\n",
    "\n",
    "# Count per-timestamp quality flags\n",
    "total_flagged_timestamps = 0\n",
    "for col in sensor_cols + bool_cols:\n",
    "    if f'{col}_quality_flag' in quality_flags_df.columns:\n",
    "        total_flagged_timestamps += quality_flags_df[f'{col}_quality_flag'].sum()\n",
    "\n",
    "print(f\" Timestamp-level quality flags: {total_flagged_timestamps:,}\")\n",
    "print(f\"   (Note: One timestamp can have multiple sensor issues)\")"
   ]
  },
