   "source": [
    "# Abstract events for all cycles using SEQUENTIAL approach\n",
    "print(\" Abstracting events using sequential process model...\\n\")\n",
    "\n",
    "all_events = []\n",
    "cycles_to_process = df['Q_Cell_CycleCount'].unique()[:50]  # Process first 50 cycles\n",
    "\n",
    "for cycle_id in cycles_to_process:\n",
    "    cycle_df = df[df['Q_Cell_CycleCount'] == cycle_id].copy()\n",
    "    \n",
    "    # Skip very short cycles (likely incomplete)\n",
    "    if len(cycle_df) < 50:\n",
    "        continue\n",
    "    \n",
    "    # Use the NEW sequential abstraction function\n",
    "    cycle_events = abstract_events_sequential(cycle_df, cycle_id, quality_flags_df)\n",
    "    all_events.extend(cycle_events)\n",
    "    \n",
    "    if cycle_id % 10 == 0:\n",
    "        print(f\"  Processed cycle {cycle_id}...\")\n",
    "\n",
    "# Create event log DataFrame with pm4py standard column names\n",
    "event_log = pd.DataFrame(all_events)\n",
    "\n",
    "# Rename columns to pm4py standard format\n",
    "event_log = event_log.rename(columns={\n",
    "    'case_id': 'case:concept:name',\n",
    "    'activity': 'concept:name',\n",
    "    'timestamp': 'time:timestamp'\n",
    "})\n",
    "\n",
    "event_log = event_log.sort_values(['case:concept:name', 'time:timestamp']).reset_index(drop=True)\n",
    "\n",
    "print(f\"\\n Event abstraction complete!\")\n",
    "print(f\"\\n Event Log Statistics:\")\n",
    "print(f\"  Total events: {len(event_log)}\")\n",
    "print(f\"  Total cases: {event_log['case:concept:name'].nunique()}\")\n",
    "print(f\"  Unique activities: {event_log['concept:name'].nunique()}\")\n",
    "print(f\"  Events with quality flags: {event_log['quality_flag'].sum()}\")\n",
    "print(f\"  Quality flag percentage: {event_log['quality_flag'].sum() / len(event_log) * 100:.1f}%\")\n",
    "\n",
    "# Check events per case distribution\n",
    "events_per_case = event_log.groupby('case:concept:name').size()\n",
    "print(f\"\\n  Events per case:\")\n",
    "print(f\"    Mean: {events_per_case.mean():.1f}\")\n",
    "print(f\"    Median: {events_per_case.median():.0f}\")\n",
    "print(f\"    Min: {events_per_case.min()}, Max: {events_per_case.max()}\")\n",
    "\n",
    "print(f\"\\n  Activity distribution:\")\n",
    "print(event_log['concept:name'].value_counts())\n",
    "\n",
    "print(f\"\\n Sequential Approach:\")\n",
    "print(f\"   Each robot now has exactly ONE pick and ONE place event\")\n",
    "print(f\"   This creates more consistent variants across cycles\")"
