   "source": [
    "## 3. Event Abstraction\n",
    "\n",
    "Transform raw sensor patterns into high-level process events. We detect activities by analyzing:\n",
    "- **Robot gripper actions**: Load changes indicate pick/place operations\n",
    "- **Robot movements**: Joint angle changes indicate robot activity\n",
    "- **Conveyor operations**: Speed changes indicate material transport\n",
    "- **Safety events**: Door status and emergency stops"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "3aefa44f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✓ Sequential event abstraction function defined\n",
      "  Key change: Identifies ONE pick and ONE place per robot\n",
      "  Result: Consistent event sequences across cycles\n"
     ]
    }
   ],
   "source": [
    "def abstract_events_sequential(cycle_df, cycle_id, quality_flags_df):\n",
    "    \"\"\"\n",
    "    Abstract events using a SEQUENTIAL PROCESS MODEL approach.\n",
    "    Instead of detecting every peak, we identify the expected sequence of operations.\n",
    "    \n",
    "    Expected process flow:\n",
    "    1. Cycle_Start\n",
    "    2. Each robot performs ONE pick and ONE place operation in sequence\n",
    "    3. Conveyors transport materials\n",
    "    4. Cycle_End\n",
    "    \n",
    "    This creates consistent variants across cycles.\n",
    "    \"\"\"\n",
    "    events = []\n",
    "    \n",
    "    # Add cycle start event\n",
    "    events.append({\n",
    "        'case_id': f'Cycle_{cycle_id}',\n",
    "        'activity': 'Cycle_Start',\n",
    "        'timestamp': cycle_df['timestamp'].iloc[0],\n",
    "        'quality_flag': False\n",
    "    })\n",
    "    \n",
    "    # For each robot, identify the PRIMARY pick and place operations\n",
    "    # We look for the STRONGEST signal (highest magnitude change)\n",
    "    for robot_num in range(1, 5):\n",
    "        load_col = f'I_R0{robot_num}_Gripper_Load'\n",
    "        load_data = cycle_df[load_col].values\n",
    "        \n",
    "        # Calculate load changes\n",
    "        load_diff = np.diff(load_data)\n",
    "        \n",
    "        # Find the strongest POSITIVE change (Pick - gripper load increases)\n",
    "        positive_changes = np.where(load_diff > 0)[0]\n",
    "        if len(positive_changes) > 0:\n",
    "            # Get the index with maximum positive change\n",
    "            pick_idx = positive_changes[np.argmax(load_diff[positive_changes])]\n",
    "            \n",
    "            df_idx = cycle_df.index[pick_idx]\n",
    "            quality_flag_col = f'{load_col}_quality_flag'\n",
    "            has_quality_issue = False\n",
    "            if quality_flag_col in quality_flags_df.columns and df_idx in quality_flags_df.index:\n",
    "                flag_value = quality_flags_df.loc[df_idx, quality_flag_col]\n",
    "                has_quality_issue = bool(flag_value.iloc[0] if hasattr(flag_value, 'iloc') else flag_value)\n",
    "            \n",
    "            events.append({\n",
    "                'case_id': f'Cycle_{cycle_id}',\n",
    "                'activity': f'Robot{robot_num}_Pick',\n",
    "                'timestamp': cycle_df['timestamp'].iloc[pick_idx],\n",
    "                'quality_flag': has_quality_issue,\n",
    "                'sensor': load_col,\n",
    "                'value': float(load_data[pick_idx])\n",
    "            })\n",
    "        \n",
    "        # Find the strongest NEGATIVE change (Place - gripper load decreases)\n",
    "        negative_changes = np.where(load_diff < 0)[0]\n",
    "        if len(negative_changes) > 0:\n",
    "            # Get the index with maximum negative change\n",
    "            place_idx = negative_changes[np.argmin(load_diff[negative_changes])]\n",
    "            \n",
    "            df_idx = cycle_df.index[place_idx]\n",
    "            quality_flag_col = f'{load_col}_quality_flag'\n",
    "            has_quality_issue = False\n",
    "            if quality_flag_col in quality_flags_df.columns and df_idx in quality_flags_df.index:\n",
    "                flag_value = quality_flags_df.loc[df_idx, quality_flag_col]\n",
    "                has_quality_issue = bool(flag_value.iloc[0] if hasattr(flag_value, 'iloc') else flag_value)\n",
    "            \n",
    "            events.append({\n",
    "                'case_id': f'Cycle_{cycle_id}',\n",
    "                'activity': f'Robot{robot_num}_Place',\n",
    "                'timestamp': cycle_df['timestamp'].iloc[place_idx],\n",
    "                'quality_flag': has_quality_issue,\n",
    "                'sensor': load_col,\n",
    "                'value': float(load_data[place_idx])\n",
    "            })\n",
    "    \n",
    "    # For conveyors, detect if they were active (simplified - just check if used)\n",
    "    for conv_num in range(1, 5):\n",
    "        speed_col = f'M_Conv{conv_num}_Speed_mmps'\n",
    "        speed_data = cycle_df[speed_col].values\n",
    "        \n",
    "        # Check if conveyor was active (max speed > threshold)\n",
    "        if np.max(speed_data) > 10:\n",
    "            # Find the first significant activation\n",
    "            moving_indices = np.where(speed_data > 10)[0]\n",
    "            if len(moving_indices) > 0:\n",
    "                start_idx = moving_indices[0]\n",
    "                \n",
    "                df_idx = cycle_df.index[start_idx]\n",
    "                quality_flag_col = f'{speed_col}_quality_flag'\n",
    "                has_quality_issue = False\n",
    "                if quality_flag_col in quality_flags_df.columns and df_idx in quality_flags_df.index:\n",
    "                    flag_value = quality_flags_df.loc[df_idx, quality_flag_col]\n",
    "                    has_quality_issue = bool(flag_value.iloc[0] if hasattr(flag_value, 'iloc') else flag_value)\n",
    "                \n",
    "                events.append({\n",
    "                    'case_id': f'Cycle_{cycle_id}',\n",
    "                    'activity': f'Conveyor{conv_num}_Transport',\n",
    "                    'timestamp': cycle_df['timestamp'].iloc[start_idx],\n",
    "                    'quality_flag': has_quality_issue,\n",
    "                    'sensor': speed_col,\n",
    "                    'value': float(speed_data[start_idx])\n",
    "                })\n",
    "    \n",
    "    # Detect safety events (only if doors actually opened)\n",
    "    if cycle_df['I_SafetyDoor1_Status'].any() or cycle_df['I_SafetyDoor2_Status'].any():\n",
    "        events.append({\n",
    "            'case_id': f'Cycle_{cycle_id}',\n",
    "            'activity': 'Safety_Door_Event',\n",
    "            'timestamp': cycle_df['timestamp'].iloc[len(cycle_df)//2],\n",
    "            'quality_flag': True,\n",
    "            'sensor': 'I_SafetyDoor1_Status'\n",
    "        })\n",
    "    \n",
    "    # Add cycle end event\n",
    "    events.append({\n",
    "        'case_id': f'Cycle_{cycle_id}',\n",
    "        'activity': 'Cycle_End',\n",
    "        'timestamp': cycle_df['timestamp'].iloc[-1],\n",
    "        'quality_flag': False\n",
    "    })\n",
    "    \n",
    "    # Sort events by timestamp to ensure correct ordering\n",
    "    events = sorted(events, key=lambda x: x['timestamp'])\n",
    "    \n",
    "    return events\n",
    "\n",
    "print(\" Sequential event abstraction function defined\")\n",
    "print(\"  Key change: Identifies ONE pick and ONE place per robot\")\n",
    "print(\"  Result: Consistent event sequences across cycles\")"
   ]
  },
