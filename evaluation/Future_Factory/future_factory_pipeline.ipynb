   "source": [
    "# Select ground truth: cycle with median event count and low quality issues\n",
    "median_events = cycle_stats_df['num_events'].median()\n",
    "print(f\"Median events per cycle: {median_events:.0f}\\n\")\n",
    "\n",
    "# Improved selection: prioritize low quality ratio and typical event count\n",
    "candidates = cycle_stats_df[\n",
    "    (cycle_stats_df['num_events'] >= median_events * 0.8) &  # Reasonable number of events\n",
    "    (cycle_stats_df['num_events'] <= median_events * 1.2)\n",
    "].copy()\n",
    "\n",
    "if len(candidates) > 0:\n",
    "    # Sort by quality ratio (prefer lower), then by how close to median\n",
    "    candidates['distance_from_median'] = np.abs(candidates['num_events'] - median_events)\n",
    "    candidates = candidates.sort_values(['quality_ratio', 'distance_from_median'])\n",
    "    ground_truth_case = candidates.iloc[0]['case_id']\n",
    "    print(f\"Selected from {len(candidates)} candidates with typical event count\")\n",
    "else:\n",
    "    # Fallback: select cycle with lowest quality ratio and closest to median\n",
    "    cycle_stats_df['distance_from_median'] = np.abs(cycle_stats_df['num_events'] - median_events)\n",
    "    cycle_stats_df_sorted = cycle_stats_df.sort_values(['quality_ratio', 'distance_from_median'])\n",
    "    ground_truth_case = cycle_stats_df_sorted.iloc[0]['case_id']\n",
    "    print(f\"Using fallback selection (no candidates in median range)\")\n",
    "\n",
    "ground_truth_events = event_log[event_log['case:concept:name'] == ground_truth_case].copy()\n",
    "\n",
    "print(f\"\\n Selected Ground Truth Case: {ground_truth_case}\")\n",
    "print(f\"\\n   Statistics:\")\n",
    "gt_stats = cycle_stats_df[cycle_stats_df['case_id'] == ground_truth_case].iloc[0]\n",
    "print(f\"   - Number of events: {gt_stats['num_events']}\")\n",
    "print(f\"   - Quality issues: {gt_stats['num_quality_issues']}\")\n",
    "print(f\"   - Quality ratio: {gt_stats['quality_ratio']:.1%}\")\n",
    "print(f\"   - Duration: {gt_stats['duration']:.1f} seconds\")\n",
    "print(f\"   - Unique activities: {gt_stats['unique_activities']}\")\n",
    "\n",
