    "print(f\"\\n Expected result: <20% variant diversity (most cycles follow same process)\")\n",
    "print(f\" Problem if >80%: Each cycle is still a unique variant\")\n",
    "\n",
    "print(f\"\\n\\nTop 10 most common variants:\")\n",
    "# Sort variants by frequency\n",
    "variant_counts = sorted([(count, variant) for variant, count in pm4py.get_variants_as_tuples(event_log).items()], \n",
    "                       key=lambda x: x[0], reverse=True)\n",
    "\n",
    "for i, (count, sequence) in enumerate(variant_counts[:10], 1):\n",
    "    print(f\"\\n{i}. Variant with {count} case(s) ({count/event_log['case:concept:name'].nunique()*100:.1f}%):\")\n",
