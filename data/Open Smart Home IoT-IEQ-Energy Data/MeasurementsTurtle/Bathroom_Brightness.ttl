osh:Bathroom-brigh-Sensor-obs0 a owl:NamedIndividual,
        sosa:Observation ;
    sosa:hasFeatureOfInterest osh:Bathroom ;
    sosa:hasResult [ a om:Measure ;
            om:hasNumericalValue 0e+00 ;
            om:hasUnit om:lux ] ;
    sosa:madeBySensor osh:Bathroom-brigh-Sensor ;
    sosa:observedProperty osh:Bathroom-brigh ;
