osh:Bathroom-tempT-Sensor-obs0 a owl:NamedIndividual,
        sosa:Observation ;
    sosa:hasFeatureOfInterest osh:Bathroom ;
    sosa:hasResult [ a om:Measure ;
            om:hasNumericalValue 2.275e+01 ;
            om:hasUnit om:degreeCelsius ] ;
    sosa:madeBySensor osh:Bathroom-tempT-Sensor ;
    sosa:observedProperty osh:Bathroom-tempT ;
    sosa:resultTime "2017-03-09T00:57:47+01:00"^^xsd:dateTime .

