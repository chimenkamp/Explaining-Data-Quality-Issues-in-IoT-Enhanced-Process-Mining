osh:Room3-temp-Sensor-obs0 a owl:NamedIndividual,
        sosa:Observation ;
    sosa:hasFeatureOfInterest osh:Room3 ;
    sosa:hasResult [ a om:Measure ;
            om:hasNumericalValue 1.78e+01 ;
            om:hasUnit om:degreeCelsius ] ;
    sosa:madeBySensor osh:Room3-temp-Sensor ;
    sosa:observedProperty osh:Room3-temp ;
    sosa:resultTime "2017-03-09T01:16:22+01:00"^^xsd:dateTime .

