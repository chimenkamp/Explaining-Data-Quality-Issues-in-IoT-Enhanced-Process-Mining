osh:Kitchen-tempT-Sensor-obs0 a owl:NamedIndividual,
        sosa:Observation ;
    sosa:hasFeatureOfInterest osh:Kitchen ;
    sosa:hasResult [ a om:Measure ;
            om:hasNumericalValue 1.71e+01 ;
            om:hasUnit om:degreeCelsius ] ;
    sosa:madeBySensor osh:Kitchen-tempT-Sensor ;
    sosa:observedProperty osh:Kitchen-tempT ;
    sosa:resultTime "2017-03-09T01:25:24+01:00"^^xsd:dateTime .

