osh:Room2-tempT-Sensor-obs0 a owl:NamedIndividual,
        sosa:Observation ;
    sosa:hasFeatureOfInterest osh:Room2 ;
    sosa:hasResult [ a om:Measure ;
            om:hasNumericalValue 1.788e+01 ;
            om:hasUnit om:degreeCelsius ] ;
    sosa:madeBySensor osh:Room2-tempT-Sensor ;
    sosa:observedProperty osh:Room2-tempT ;
